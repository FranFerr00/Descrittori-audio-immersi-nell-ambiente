#N canvas 400 100 760 540 10;
#X text 23 16 tpr - tonal power ratio + n_peaks monolitico;
#X text 23 36 Identifica i picchi tonali (regola MPEG-1 \, +/-7 dB sui vicini a +/-2 bin) e calcola il rapporto tonal/noise in dB.;
#X text 20 96 ARGOMENTI:;
#X text 40 116 1 nome array spettro (symbol);
#X text 40 131 2 lobe_width (int \, default 1) - semi-ampiezza del lobo per banda tonale;
#X text 20 171 INLET:;
#X text 40 191 1 (bang) esegue il calcolo;
#X text 40 206 2 (float) aggiorna lobe_width;
#X text 20 236 OUTLET (sx -> dx): float tpr_dB \, float n_peaks tonali;
#X text 20 271 FORMULA:;
#X text 40 291 power[k] = X[k]^2; total = sum(power);
#X text 40 306 picchi locali stretti (>vicini +/-1) con regola MPEG-1 a +/-2;
#X text 40 321 tonal = sum lobi +/-L attorno ai picchi tonali;
#X text 40 336 tpr_dB = 10 * log10(tonal / max(total - tonal \, eps));
#X text 20 366 Niente gating relativo: il filtro e' la regola MPEG-1 \, non la soglia in dB sul picco.;
#X obj 41 480 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 510 tpr spettro 1;
#X floatatom 200 510 8 0 0 0 - tpr_dB - 0;
#X floatatom 320 510 6 0 0 0 - n_peaks - 0;
#X text 66 480 bang -> calcola;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 16 1 18 0;
