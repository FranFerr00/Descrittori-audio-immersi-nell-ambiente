#N canvas 400 100 700 460 10;
#X text 23 16 zcr - zero crossing rate monolitico;
#X text 23 36 Frazione di campioni adiacenti con segno opposto in un frame di forma d'onda (time-domain).;
#X text 20 86 ARGOMENTI:;
#X text 40 106 1 nome array della forma d'onda (symbol) - NON dello spettro;
#X text 20 146 INLET:;
#X text 40 166 1 (bang) esegue il calcolo;
#X text 20 196 OUTLET: float \, ZCR in [0 \, 1];
#X text 20 221 FORMULA:;
#X text 40 241 crossings = #{ k : sign(x[k]) != sign(x[k+1]) };
#X text 40 256 zcr = crossings / (N - 1);
#X text 20 286 Tipico uso: array popolato con [tabwrite~] dalla forma d'onda audio \, una finestra di N campioni (es. 1024 a 96 kHz).;
#X obj 41 405 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 435 zcr frame_audio;
#X floatatom 220 435 8 0 0 0 - - - 0;
#X text 66 405 bang -> calcola;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
