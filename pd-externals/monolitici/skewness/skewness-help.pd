#N canvas 400 100 720 480 10;
#X text 23 16 skewness - spectral skewness monolitica;
#X text 23 36 Terzo momento standardizzato della distribuzione di magnitudo \, calcolato in bin (adimensionale).;
#X text 20 86 ARGOMENTI:;
#X text 40 106 1 nome array spettro (symbol);
#X text 40 121 2 threshold_db (float negativo \, default -30);
#X text 20 151 INLET:;
#X text 40 171 1 (bang) esegue il calcolo;
#X text 40 186 2 (float) aggiorna threshold_db;
#X text 20 216 OUTLET: float \, skewness adimensionale;
#X text 20 241 FORMULA:;
#X text 40 261 c = sum(k*X)/sum(X) (centroide in bin);
#X text 40 276 s = sqrt(sum(k^2*X)/sum(X) - c^2) (spread in bin);
#X text 40 291 skew = sum(((k-c)/s)^3 * X) / sum(X);
#X text 20 321 Skewness e' scale-invariante: bin o Hz danno lo stesso risultato \, quindi niente sr/fftsize.;
#X obj 41 425 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 455 skewness spettro -30;
#X floatatom 240 455 8 0 0 0 - - - 0;
#X text 66 425 bang -> calcola;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
