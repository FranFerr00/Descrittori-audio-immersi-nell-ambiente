#N canvas 400 100 740 540 10;
#X text 23 16 slope - spectral slope monolitico;
#X text 23 36 Pendenza della regressione lineare di 20*log10(X[k]) su log2(frequenza in Hz) sui bin sopra soglia.;
#X text 20 96 ARGOMENTI:;
#X text 40 116 1 nome array spettro (symbol);
#X text 40 131 2 sample rate (float \, default = sr motore Pd);
#X text 40 146 3 fftsize (float \, default 8192);
#X text 40 161 4 threshold_db (float negativo \, default -30);
#X text 20 191 INLET:;
#X text 40 211 1 (bang) esegue il calcolo;
#X text 40 226 2 (float) aggiorna sample rate;
#X text 40 241 3 (float) aggiorna fftsize;
#X text 40 256 4 (float) aggiorna threshold_db;
#X text 20 286 OUTLET: float \, slope in dB/ottava (negativo per spettri decrescenti);
#X text 20 321 FORMULA:;
#X text 40 341 x_k = log2(freq[k]) (Hz \, k > 0);
#X text 40 356 y_k = 20 * log10(X[k]) sui bin sopra soglia;
#X text 40 371 slope = sum((x - mean_x)*(y - mean_y)) / sum((x - mean_x)^2);
#X text 20 401 Pendenza media dello spettro in scala log-log. Tipicamente -6 dB/oct per spettri "naturali" \, piu' ripido per spettri tonali stretti.;
#X obj 41 485 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 515 slope spettro 96000 8192 -30;
#X floatatom 250 515 8 0 0 0 - - - 0;
#X text 66 485 bang -> calcola;
#X connect 18 0 19 0;
#X connect 19 0 20 0;
