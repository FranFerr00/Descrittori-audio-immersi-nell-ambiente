#N canvas 400 100 700 460 10;
#X text 23 16 entropy - spectral entropy monolitica;
#X text 23 36 Entropia di Shannon di p(k) = X[k]^2 / sum(X^2) \, normalizzata da log2(N).;
#X text 20 86 ARGOMENTI:;
#X text 40 106 1 nome array spettro (symbol);
#X text 20 136 INLET:;
#X text 40 156 1 (bang) esegue il calcolo;
#X text 20 186 OUTLET: float \, entropy in [0 \, 1];
#X text 20 211 FORMULA:;
#X text 40 231 power[k] = X[k]^2; total = sum(power);
#X text 40 246 p[k] = power[k] / total (per power[k] > 0);
#X text 40 261 H = - sum(p * log2(p));
#X text 40 276 entropy = H / log2(N);
#X text 20 306 Niente gating: l'entropy guarda la distribuzione su tutti i bin (un gate eliminerebbe la coda di rumore che si vuole misurare).;
#X obj 41 405 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
