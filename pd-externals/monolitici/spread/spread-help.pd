#N canvas 400 100 720 580 10;
#X text 23 16 spread - spread spettrale monolitico;
#X text 23 36 Calcola lo spread spettrale (deviazione standard della distribuzione di magnitudo rispetto al centroide) in un singolo external.;
#X text 23 72 Due passate interne: picco + accumulazione di S0/S1/S2 con soglia relativa (dB sotto il picco).;
#X text 20 106 ARGOMENTI:;
#X text 40 126 1 nome array spettro (symbol);
#X text 40 141 2 sample rate (float \, default = sr motore Pd);
#X text 40 156 3 fftsize (float \, default 8192);
#X text 40 171 4 threshold_db (float negativo \, default -30);
#X text 20 201 INLET:;
#X text 40 221 1 (bang) esegue il calcolo;
#X text 40 236 2 (float) aggiorna sample rate;
#X text 40 251 3 (float) aggiorna fftsize;
#X text 40 266 4 (float) aggiorna threshold_db;
#X text 20 296 OUTLET: float \, spread in Hz;
#X text 20 321 FORMULA (identita' della varianza):;
#X text 40 341 peak = max(X[k]);
#X text 40 356 soglia = peak * 10^(threshold_db/20);
#X text 40 371 S0 = sum(X[k]) \, S1 = sum(k * X[k]) \, S2 = sum(k^2 * X[k]);
#X text 40 386 centroide_bin = S1/S0;
#X text 40 401 varianza_bin = S2/S0 - centroide_bin^2;
#X text 40 416 spread_hz = sqrt(varianza_bin) * sr / fftsize;
#X text 20 446 Descrittore autonomo: ricalcola internamente picco e centroide \, senza dipendere da un [centroid] esterno.;
#X text 20 481 NOTA: sr letto alla creazione dell'oggetto. Se cambi sr del motore Pd \, aggiorna via il secondo inlet o ricrea l'oggetto.;
#X obj 41 525 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 555 spread spettro 96000 8192 -30;
#X floatatom 230 555 8 0 0 0 - - - 0;
#X text 66 525 bang -> calcola;
#X connect 23 0 24 0;
#X connect 24 0 25 0;
