#N canvas 400 100 740 540 10;
#X text 23 16 obsir_std - OBSIR-std (Essid \, Richard \, David 2006);
#X text 23 46 Deviazione standard delle differenze di log-energia tra bande ottavali consecutive. Misura quanto la pendenza spettrale e' irregolare per banda.;
#X text 20 106 ARGOMENTI:;
#X text 40 126 1 nome array spettro (symbol);
#X text 40 141 2 sample rate (float \, default = sr motore Pd);
#X text 40 156 3 fftsize (float \, default 8192);
#X text 20 186 INLET:;
#X text 40 206 1 (bang) esegue il calcolo;
#X text 40 221 2 (float) aggiorna sample rate;
#X text 40 236 3 (float) aggiorna fftsize;
#X text 20 266 OUTLET: float \, std delle differenze ottavali in log10 (adimensionale);
#X text 20 301 FORMULA:;
#X text 40 321 bande Hz: 200-400-800-1600-3200-6400-10000 (6 bande \, 5 diff);
#X text 40 336 power[k] = X[k]^2; log_E[i] = log10(sum_k power[k] in banda i);
#X text 40 351 obsir[j] = log_E[j+1] - log_E[j];
#X text 40 366 obsir_std = std(obsir) (popolazione \, ddof=0);
#X text 20 396 NESSUN gating: con la soglia intere bande andrebbero a log10(0)=-inf. Ortogonale allo slope (pendenza media vs irregolarita' della pendenza).;
#X obj 41 485 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 515 obsir_std spettro 96000 8192;
#X floatatom 270 515 8 0 0 0 - - - 0;
#X text 66 485 bang -> calcola;
#X connect 17 0 18 0;
#X connect 18 0 19 0;
