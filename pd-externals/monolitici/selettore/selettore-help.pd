#N canvas 300 60 780 740 10;
#X text 20 16 selettore - argmax con isteresi e tempo di permanenza;
#X text 20 36 Riceve N grandezze e emette l'INDICE 0..N-1 di quella dominante. Pensato per pilotare un selettore a N stati (es. la forma del filtro del bicomb) dai C1 delle famiglie via argmax.;
#X text 20 96 ARGOMENTI: [selettore N (margine) (dwell_ms) (finestra)];
#X text 40 116 N numero di ingressi (>= 2 \, obbligatorio);
#X text 40 131 margine isteresi sul valore (default 0): il candidato deve battere il vincente di almeno tanto per scalzarlo;
#X text 40 161 dwell_ms tempo minimo di permanenza dopo un cambio (default 200);
#X text 40 191 finestra n. di frame su cui mediare ogni ingresso prima dell'argmax (default 1 = nessuna media): liscia la decisione alla sorgente;
#X text 20 226 INLET:;
#X text 40 246 caldo (sinistro) float = valore del 1o ingresso \, fa scattare la valutazione (accetta anche una lista di N float);
#X text 40 276 freddi (1..N-1) memorizzano l'ultimo valore;
#X text 40 291 (margine f) / (dwell f) / (finestra f) cambiano i parametri a runtime;
#X text 40 306 (reset) torna a 'nessun vincente' e azzera la storia; (bang) riemette l'indice corrente;
#X text 20 336 OUTLET: float \, indice del vincente. Emesso SOLO quando l'indice cambia (non a ogni frame).;
#X text 20 376 NOTA: tre livelli di lisciatura. 'finestra' media gli ingressi alla sorgente; 'margine' ignora le differenze piccole; 'dwell' impone un tempo minimo fra cambi. Con due ingressi quasi pari l'uscita resta ferma.;
#X text 20 506 ESEMPIO: muovi gli ingressi e guarda l'indice. 0=caldo (valuta) \, 1..3=freddi. Cambia margine/dwell/finestra per sentire l'effetto.;
#X text 38 546 0 (caldo);
#X floatatom 40 566 5 0 0 0 - - - 0;
#X floatatom 120 566 5 0 0 0 - - - 0;
#X floatatom 200 566 5 0 0 0 - - - 0;
#X floatatom 280 566 5 0 0 0 - - - 0;
#X obj 40 636 selettore 4 0.05 300 1;
#X floatatom 40 686 5 0 0 0 indice - - 0;
#X obj 130 686 print indice;
#X msg 240 596 bang;
#X msg 300 596 reset;
#X floatatom 420 546 5 0 0 0 margine - - 0;
#X msg 420 576 margine \$1;
#X floatatom 540 546 5 0 0 0 dwell-ms - - 0;
#X msg 540 576 dwell \$1;
#X floatatom 660 546 5 1 64 0 finestra - - 0;
#X msg 660 576 finestra \$1;
#X connect 16 0 20 0;
#X connect 17 0 20 1;
#X connect 18 0 20 2;
#X connect 19 0 20 3;
#X connect 20 0 21 0;
#X connect 20 0 22 0;
#X connect 23 0 20 0;
#X connect 24 0 20 0;
#X connect 25 0 26 0;
#X connect 26 0 20 0;
#X connect 27 0 28 0;
#X connect 28 0 20 0;
