#N canvas 300 60 800 780 10;
#X text 20 16 matrice - matrice di correlazione rolling fra K serie;
#X text 20 36 K serie temporali in ingresso (un inlet per serie) \, finestra mobile di correlazione \, scalari di sintesi configurabili in uscita (uno per outlet). Da mettere in copia \, una per gruppo di descrittori.;
#X text 20 96 ARGOMENTI: [matrice K (N) (D) (scalari...)];
#X text 40 116 K serie/inlet in ingresso (>= 2 \, obbligatorio);
#X text 40 131 N finestra rolling (float opz. \, default max(16 \, 4*K));
#X text 40 146 D lag in frame per e1/e2 (float opz. \, default N/2);
#X text 40 161 scalari parole che scelgono le uscite (default c1);
#X text 20 191 SCALARI disponibili (uno per uscita \, nell'ordine dato):;
#X text 40 211 c1 coerenza media segnata mean(r_ij) [-1 \, +1];
#X text 40 226 c2 concentrazione assiale 2|lam1|/sum|lam|-1 [-1 \, +1] (K>=3);
#X text 40 241 c3 asimmetria di segno (n+ - n-)/tot [-1 \, +1];
#X text 40 256 sigma dispersione std(r_ij);
#X text 40 271 polar polarizzazione |c1|/mean|r|;
#X text 40 286 e1 velocita' evoluzione ||M(t)-M(t-D)||_F / sqrt(K*(K-1));
#X text 40 301 e2 coseno dei primi autovettori cos(v1(t) \, v1(t-D)) [-1 \, +1];
#X text 20 331 INLET:;
#X text 39 344 caldo (sinistro) float = valore della 1a serie \, fa scattare il frame;
#X text 40 366 caldo accetta anche una lista di K float = frame completo;
#X text 40 381 freddi (1..K-1) memorizzano l'ultimo valore della serie;
#X text 40 396 (reset) sull'inlet caldo svuota finestra e storia;
#X text 20 421 OUTLET: un float per scalare scelto (qui c1) \, emesso a finestra piena;
#X text 20 446 NOTA: finche' la finestra non e' piena non esce nulla;
#X text 20 506 ESEMPIO live: 4 rumori indipendenti -> [matrice 4 c1]. Con ingressi scorrelati c1 oscilla attorno a 0;
