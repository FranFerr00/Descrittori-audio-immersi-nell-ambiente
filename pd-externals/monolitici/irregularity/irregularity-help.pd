#N canvas 400 100 720 540 10;
#X text 23 16 irregularity - spectral irregularity (variante log) monolitica;
#X text 23 46 Somma delle differenze in valore assoluto fra i log di bin adiacenti \, sui bin sopra soglia relativa.;
#X text 23 86 Due passate interne: picco + log e somma differenze.;
#X text 20 116 ARGOMENTI:;
#X text 40 136 1 nome array spettro (symbol);
#X text 40 151 2 threshold_db (float negativo \, default -30);
#X text 20 181 INLET:;
#X text 40 201 1 (bang) esegue il calcolo;
#X text 40 216 2 (float) aggiorna threshold_db;
#X text 20 246 OUTLET: float \, irregularity adimensionale;
#X text 20 271 FORMULA (variante log):;
#X text 40 291 peak = max(X[k]);
#X text 40 306 soglia = peak * 10^(threshold_db/20);
#X text 40 321 X_th[k] = X[k] se > soglia \, altrimenti log_epsilon;
#X text 40 336 irreg = sum_k | log(X_th[k]) - log(X_th[k+1]) |;
#X text 20 366 I bin sotto soglia non vengono saltati: vengono sostituiti con log_epsilon (floor) per non spostare i vicini e inventare transizioni grandi.;
#X text 20 416 Range: [0 \, +inf). ~0 = spettro liscio in scala log \, alto = frastagliato.;
#X obj 41 480 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 510 irregularity spettro -30;
#X floatatom 250 510 8 0 0 0 - - - 0;
#X text 66 480 bang -> calcola;
#X connect 17 0 18 0;
#X connect 18 0 19 0;
