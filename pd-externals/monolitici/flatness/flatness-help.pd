#N canvas 400 100 720 520 10;
#X text 23 16 flatness - spectral flatness monolitica;
#X text 23 36 Calcola la SFM (Spectral Flatness Measure) sui bin sopra soglia relativa.;
#X text 23 72 Due passate interne: picco + somma log e somma lineare sui bin attivi \, infine geom_mean / arith_mean.;
#X text 20 106 ARGOMENTI:;
#X text 40 126 1 nome array spettro (symbol);
#X text 40 141 2 threshold_db (float negativo \, default -30);
#X text 20 171 INLET:;
#X text 40 191 1 (bang) esegue il calcolo;
#X text 40 206 2 (float) aggiorna threshold_db;
#X text 20 236 OUTLET: float \, flatness in [0 \, 1];
#X text 20 261 FORMULA:;
#X text 40 281 peak = max(X[k]);
#X text 40 296 soglia = peak * 10^(threshold_db/20);
#X text 40 311 attivi = { X[k] : X[k] > soglia };
#X text 40 326 geom = exp(mean(log(attivi + epsilon)));
#X text 40 341 arith = mean(attivi);
#X text 40 356 SFM = geom / arith;
#X text 20 386 Range: 0 (energia in un picco) ... 1 (spettro piatto \, rumore bianco). Adimensionale: non dipende da sr/fftsize.;
#X obj 41 465 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 495 flatness spettro -30;
#X floatatom 230 495 8 0 0 0 - - - 0;
#X text 66 465 bang -> calcola;
#X connect 18 0 19 0;
#X connect 19 0 20 0;
