#N canvas 400 100 720 480 10;
#X text 23 16 tonality - tonality coefficient monolitico;
#X text 23 36 Mappatura della SFM (calcolata internamente) in [0 \, 1] secondo Peeters 9.1.;
#X text 20 86 ARGOMENTI:;
#X text 40 106 1 nome array spettro (symbol);
#X text 40 121 2 threshold_db (float negativo \, default -30);
#X text 20 151 INLET:;
#X text 40 171 1 (bang) esegue il calcolo;
#X text 40 186 2 (float) aggiorna threshold_db;
#X text 20 216 OUTLET: float \, tonality in [0 \, 1];
#X text 20 241 FORMULA:;
#X text 40 261 sfm = flatness(X);
#X text 40 276 sfm_db = 10 * log10(sfm + epsilon);
#X text 40 291 tonality = min(sfm_db / -60 \, 1);
#X text 20 321 1 = perfettamente tonale \, 0 = perfettamente rumoroso. Soglia pratica a -60 dB di SFM.;
#X obj 41 425 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 455 tonality spettro -30;
#X floatatom 230 455 8 0 0 0 - - - 0;
#X text 66 425 bang -> calcola;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
