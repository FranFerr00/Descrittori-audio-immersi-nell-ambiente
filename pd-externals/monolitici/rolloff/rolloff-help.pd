#N canvas 400 100 740 580 10;
#X text 23 16 rolloff - spectral rolloff monolitico;
#X text 23 36 Frequenza sotto la quale cade una frazione "percentile" dell'energia spettrale cumulata.;
#X text 20 86 ARGOMENTI:;
#X text 40 106 1 nome array spettro (symbol);
#X text 40 121 2 sample rate (float \, default = sr motore Pd);
#X text 40 136 3 fftsize (float \, default 8192);
#X text 40 151 4 threshold_db (float negativo \, default -30);
#X text 40 166 5 percentile (float in (0 \, 1] \, default 0.85);
#X text 20 196 INLET:;
#X text 40 216 1 (bang) esegue il calcolo;
#X text 40 231 2 (float) aggiorna sample rate;
#X text 40 246 3 (float) aggiorna fftsize;
#X text 40 261 4 (float) aggiorna threshold_db;
#X text 40 276 5 (float) aggiorna percentile;
#X text 20 306 OUTLET: float \, rolloff in Hz;
#X text 20 331 FORMULA:;
#X text 40 351 power[k] = X[k]^2 sui bin sopra soglia;
#X text 40 366 total = sum(power); soglia = total * percentile;
#X text 40 381 bin_rolloff = primo k con sum_{i<=k} power[i] >= soglia;
#X text 40 396 rolloff_hz = bin_rolloff * sr / fftsize;
#X text 20 426 Misura il "punto di taglio" energetico dello spettro: indica fino a che frequenza si concentra la maggior parte dell'energia.;
#X obj 41 525 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 555 rolloff spettro 96000 8192 -30 0.85;
#X floatatom 290 555 8 0 0 0 - - - 0;
#X text 66 525 bang -> calcola;
#X connect 21 0 22 0;
#X connect 22 0 23 0;
