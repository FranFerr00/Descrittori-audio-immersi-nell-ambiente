#N canvas 400 100 720 480 10;
#X text 23 16 kurtosis - spectral kurtosis (excess) monolitica;
#X text 23 36 Quarto momento standardizzato meno 3 (Fisher: gauss → 0).;
#X text 20 76 ARGOMENTI:;
#X text 40 96 1 nome array spettro (symbol);
#X text 40 111 2 threshold_db (float negativo \, default -30);
#X text 20 141 INLET:;
#X text 40 161 1 (bang) esegue il calcolo;
#X text 40 176 2 (float) aggiorna threshold_db;
#X text 20 206 OUTLET: float \, kurtosis (excess) adimensionale;
#X text 20 231 FORMULA:;
#X text 40 251 c = sum(k*X)/sum(X); s = sqrt(sum(k^2*X)/sum(X) - c^2);
#X text 40 266 kurt = sum(((k-c)/s)^4 * X) / sum(X) - 3;
#X text 20 296 Scale-invariante: bin o Hz danno lo stesso valore.;
#X obj 41 425 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
