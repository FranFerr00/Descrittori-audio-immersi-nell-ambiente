#N canvas 400 100 720 580 10;
#X text 23 16 flux - spectral flux monolitico;
#X text 23 36 Somma delle differenze in valore assoluto fra spettro corrente e spettro del frame precedente \, sui bin sopra soglia relativa.;
#X text 23 86 Stato interno: buffer del frame precedente (allocato al primo bang \, ri-allocato se la dimensione cambia).;
#X text 20 126 ARGOMENTI:;
#X text 40 146 1 nome array spettro (symbol);
#X text 40 161 2 threshold_db (float negativo \, default -30);
#X text 20 191 INLET:;
#X text 40 211 1 (bang) esegue il calcolo;
#X text 40 226 (reset) azzera il buffer del frame precedente;
#X text 40 241 2 (float) aggiorna threshold_db;
#X text 20 271 OUTLET: float \, flux adimensionale (somma di magnitudo);
#X text 20 296 FORMULA (per ogni frame):;
#X text 40 316 peak = max(X[k]);
#X text 40 331 soglia = peak * 10^(threshold_db/20);
#X text 40 346 X_th[k] = X[k] se > soglia \, altrimenti 0;
#X text 40 361 flux = sum_k | X_th[k] - X_th_prev[k] |;
#X text 20 391 NOTA: il primo bang dopo la creazione (o dopo un reset) confronta contro un buffer di zeri \, quindi vale la somma del frame corrente sopra soglia. In pratica si scarta il primo valore o si manda un (reset) prima di iniziare a usarlo.;
#X obj 41 510 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 540 flux spettro -30;
#X floatatom 220 540 8 0 0 0 - - - 0;
#X msg 110 510 reset;
#X text 66 480 bang -> calcola;
#X connect 17 0 18 0;
#X connect 18 0 19 0;
#X connect 20 0 18 0;
