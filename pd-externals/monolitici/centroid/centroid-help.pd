#N canvas 0 0 1916 979 10;
#X text 23 16 centroid - centroide spettrale monolitico;
#X text 23 36 Calcola il centroide spettrale di un array di magnitudo in un singolo external.;
#X text 23 68 Due passate interne: picco + accumulazione con soglia relativa (dB sotto il picco).;
#X text 20 96 ARGOMENTI:;
#X text 40 116 1 nome array spettro (symbol);
#X text 40 131 2 sample rate (float \, default = sr motore Pd);
#X text 40 146 3 fftsize (float \, default 8192);
#X text 40 161 4 threshold_db (float negativo \, default -30);
#X text 20 191 INLET:;
#X text 40 211 1 (bang) esegue il calcolo;
#X text 40 226 2 (float) aggiorna sample rate;
#X text 40 241 3 (float) aggiorna fftsize;
#X text 40 256 4 (float) aggiorna threshold_db;
#X text 20 286 OUTLET: float \, centroide in Hz;
#X text 20 311 FORMULA:;
#X text 40 331 peak = max(X[k]);
#X text 40 346 soglia = peak * 10^(threshold_db/20);
#X text 40 361 centroide = sum(k * X[k]) / sum(X[k]) solo per X[k] > soglia;
#X text 40 376 freq_hz = centroide * sr / fftsize;
#X obj 41 502 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 534 centroid spettro 96000 8192 -30;
#X floatatom 41 569 8 0 0 0 - - - 0;
#X text 66 501 bang -> calcola;
#X text 233 534 [centroid spettro 96000 8192 -30];
#X text 233 569 centroide in Hz;
#X text 20 411 Gli stessi risultati di analisi.py (stesso gate a -30 dB dal picco).;
#X text 19 440 NOTA: sr viene letto alla creazione dell'oggetto. Se cambi il sample rate del motore Pd dopo \, aggiorna sr via il secondo inlet o ricrea l'oggetto.;
#X connect 19 0 20 0;
#X connect 20 0 21 0;
