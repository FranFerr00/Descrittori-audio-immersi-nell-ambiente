#N canvas 400 100 700 460 10;
#X text 23 16 crest - spectral crest factor monolitico;
#X text 23 36 max / mean sui bin sopra soglia relativa.;
#X text 20 76 ARGOMENTI:;
#X text 40 96 1 nome array spettro (symbol);
#X text 40 111 2 threshold_db (float negativo \, default -30);
#X text 20 141 INLET:;
#X text 40 161 1 (bang) esegue il calcolo;
#X text 40 176 2 (float) aggiorna threshold_db;
#X text 20 206 OUTLET: float \, crest in [1 \, +inf);
#X text 20 231 FORMULA:;
#X text 40 251 peak = max(X[k]); soglia = peak * 10^(threshold_db/20);
#X text 40 266 attivi = { X[k] > soglia };
#X text 40 281 crest = max(attivi) / mean(attivi);
#X text 20 311 1 = piatto sopra soglia \, grande = un bin domina sugli altri attivi.;
#X obj 41 405 bng 18 250 50 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000;
#X obj 41 435 crest spettro -30;
#X floatatom 220 435 8 0 0 0 - - - 0;
#X text 66 405 bang -> calcola;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
